{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:royalty_record:v0.4",
  "title": "CVCP Royalty Record v0.4",
  "description": "Records value allocation and its verified attribution basis before external settlement execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "royalty_id",
    "audit_id",
    "royalty_basis",
    "value_generated",
    "value_unit",
    "allocations",
    "settlement_status",
    "created_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.4"
    },
    "record_type": {
      "const": "royalty_record"
    },
    "royalty_id": {
      "$ref": "#/$defs/royaltyId"
    },
    "audit_id": {
      "$ref": "#/$defs/auditId"
    },
    "royalty_basis": {
      "$ref": "#/$defs/royaltyBasis"
    },
    "value_generated": {
      "type": "number",
      "minimum": 0
    },
    "value_unit": {
      "$ref": "#/$defs/valueUnit"
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "settlement_request_ref": {
      "$ref": "#/$defs/settlementRequestId"
    },
    "settlement_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/settlementReceiptId"
      }
    },
    "settlement_status": {
      "enum": [
        "not_required",
        "provisional",
        "pending",
        "processing",
        "settled",
        "failed",
        "disputed"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "royalty_basis": {
            "properties": {
              "audit_status": {
                "const": "provisional"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "settlement_status": {
            "enum": [
              "provisional",
              "not_required",
              "disputed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "royalty_basis": {
            "properties": {
              "audit_status": {
                "enum": [
                  "disputed",
                  "rejected"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "settlement_status": {
            "enum": [
              "not_required",
              "disputed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "settlement_status": {
            "enum": [
              "processing",
              "settled",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "settlement_request_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "settlement_status": {
            "enum": [
              "settled",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "settlement_receipt_refs"
        ]
      }
    }
  ],
  "$defs": {
    "originId": {
      "type": "string",
      "pattern": "^OID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "contributionAssessmentId": {
      "type": "string",
      "pattern": "^CAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^AID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "royaltyId": {
      "type": "string",
      "pattern": "^RID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "settlementRequestId": {
      "type": "string",
      "pattern": "^SRQID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "settlementReceiptId": {
      "type": "string",
      "pattern": "^SRCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valueUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code"
      ],
      "properties": {
        "type": {
          "enum": [
            "fiat",
            "token",
            "credit",
            "point",
            "other"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fiat"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "pattern": "^[A-Z]{3}$"
              }
            }
          }
        }
      ]
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "contribution_weight",
        "royalty_rate",
        "amount"
      ],
      "properties": {
        "origin_id": {
          "$ref": "#/$defs/originId"
        },
        "contribution_weight": {
          "$ref": "#/$defs/score"
        },
        "royalty_rate": {
          "$ref": "#/$defs/score"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "royaltyBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution_assessment_ref",
        "audit_confidence",
        "audit_status"
      ],
      "properties": {
        "contribution_assessment_ref": {
          "$ref": "#/$defs/contributionAssessmentId"
        },
        "audit_confidence": {
          "$ref": "#/$defs/score"
        },
        "audit_status": {
          "enum": [
            "verified",
            "provisional",
            "disputed",
            "rejected"
          ]
        }
      }
    }
  }
}
