{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:value_cycle_record:v0.4",
  "title": "CVCP Value Cycle Record v0.4",
  "description": "Top-level lifecycle record linking Origin through external Settlement Receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "cycle_id",
    "origin_refs",
    "cycle_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.4"
    },
    "record_type": {
      "const": "value_cycle_record"
    },
    "cycle_id": {
      "$ref": "#/$defs/cycleId"
    },
    "origin_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/originId"
      }
    },
    "derivative_ref": {
      "$ref": "#/$defs/derivativeId"
    },
    "trace_chain_ref": {
      "$ref": "#/$defs/traceChainId"
    },
    "trace_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/traceId"
      }
    },
    "evidence_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceAssessmentId"
      }
    },
    "contribution_assessment_ref": {
      "$ref": "#/$defs/contributionAssessmentId"
    },
    "audit_ref": {
      "$ref": "#/$defs/auditId"
    },
    "royalty_ref": {
      "$ref": "#/$defs/royaltyId"
    },
    "settlement_request_ref": {
      "$ref": "#/$defs/settlementRequestId"
    },
    "settlement_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/settlementReceiptId"
      }
    },
    "transition_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/transitionId"
      }
    },
    "cycle_status": {
      "$ref": "#/$defs/cycleStatus"
    },
    "created_at": {
      "$ref": "#/$defs/dateTime"
    },
    "updated_at": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "derivative_created",
              "trace_recorded",
              "audit_pending",
              "audit_provisional",
              "audit_verified",
              "royalty_calculated",
              "settlement_pending",
              "settlement_processing",
              "settlement_failed",
              "settled",
              "disputed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "derivative_ref",
          "transition_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "trace_recorded",
              "audit_pending",
              "audit_provisional",
              "audit_verified",
              "royalty_calculated",
              "settlement_pending",
              "settlement_processing",
              "settlement_failed",
              "settled",
              "disputed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "trace_chain_ref",
          "trace_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "audit_pending",
              "audit_provisional",
              "audit_verified",
              "royalty_calculated",
              "settlement_pending",
              "settlement_processing",
              "settlement_failed",
              "settled",
              "disputed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "evidence_assessment_refs",
          "contribution_assessment_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "audit_provisional",
              "audit_verified",
              "royalty_calculated",
              "settlement_pending",
              "settlement_processing",
              "settlement_failed",
              "settled",
              "disputed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "audit_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "royalty_calculated",
              "settlement_pending",
              "settlement_processing",
              "settlement_failed",
              "settled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "royalty_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "settlement_pending",
              "settlement_processing",
              "settlement_failed",
              "settled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "settlement_request_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cycle_status": {
            "enum": [
              "settlement_processing",
              "settlement_failed",
              "settled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "settlement_receipt_refs"
        ]
      }
    }
  ],
  "$defs": {
    "originId": {
      "type": "string",
      "pattern": "^OID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "derivativeId": {
      "type": "string",
      "pattern": "^DID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^TID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "traceChainId": {
      "type": "string",
      "pattern": "^TCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "evidenceAssessmentId": {
      "type": "string",
      "pattern": "^EAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "contributionAssessmentId": {
      "type": "string",
      "pattern": "^CAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^AID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "royaltyId": {
      "type": "string",
      "pattern": "^RID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "settlementRequestId": {
      "type": "string",
      "pattern": "^SRQID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "settlementReceiptId": {
      "type": "string",
      "pattern": "^SRCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "transitionId": {
      "type": "string",
      "pattern": "^STID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^VCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "cycleStatus": {
      "type": "string",
      "enum": [
        "origin_registered",
        "derivative_created",
        "trace_recorded",
        "audit_pending",
        "audit_provisional",
        "audit_verified",
        "royalty_calculated",
        "settlement_pending",
        "settlement_processing",
        "settlement_failed",
        "settled",
        "disputed"
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
