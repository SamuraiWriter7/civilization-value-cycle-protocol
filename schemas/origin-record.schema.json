{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:origin_record:v0.4",
  "title": "CVCP Origin Record v0.4",
  "description": "Registers the source asset, rights, provenance anchor, and access policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "origin_id",
    "creator",
    "asset",
    "content_hash",
    "rights",
    "access_policy",
    "created_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.4"
    },
    "record_type": {
      "const": "origin_record"
    },
    "origin_id": {
      "$ref": "#/$defs/originId"
    },
    "creator": {
      "$ref": "#/$defs/creator"
    },
    "asset": {
      "$ref": "#/$defs/asset"
    },
    "content_hash": {
      "$ref": "#/$defs/contentHash"
    },
    "rights": {
      "$ref": "#/$defs/rights"
    },
    "access_policy": {
      "$ref": "#/$defs/accessPolicy"
    },
    "provenance_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "created_at": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "originId": {
      "type": "string",
      "pattern": "^OID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "enum": [
                  "sha256",
                  "blake3"
                ]
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha384"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{96}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{128}$"
              }
            }
          }
        }
      ]
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator_id"
      ],
      "properties": {
        "creator_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "person",
            "organization",
            "collective",
            "agent",
            "other"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "title",
        "version"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "dataset",
            "software",
            "model",
            "design",
            "mixed",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_holders",
        "license"
      ],
      "properties": {
        "rights_holders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_uri": {
          "type": "string",
          "format": "uri"
        },
        "copyright_notice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "training",
        "commercial_use",
        "attribution_required",
        "royalty_required"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "conditional"
          ]
        },
        "training": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "conditional"
          ]
        },
        "commercial_use": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "conditional"
          ]
        },
        "attribution_required": {
          "type": "boolean"
        },
        "royalty_required": {
          "type": "boolean"
        },
        "royalty_rate": {
          "$ref": "#/$defs/score"
        },
        "terms_uri": {
          "type": "string",
          "format": "uri"
        },
        "additional_terms": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "royalty_required": {
                "const": true
              }
            },
            "required": [
              "royalty_required"
            ]
          },
          "then": {
            "required": [
              "royalty_rate"
            ]
          }
        }
      ]
    }
  }
}
