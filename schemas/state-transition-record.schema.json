{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:state_transition_record:v0.5",
  "title": "CVCP State Transition Record v0.5",
  "description": "Records one auditable transition between Value Cycle states including reconciliation and recovery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "transition_id",
    "cycle_id",
    "previous_status",
    "next_status",
    "evidence_refs",
    "transitioned_at",
    "actor_id",
    "reason",
    "transition_hash"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.5"
    },
    "record_type": {
      "const": "state_transition_record"
    },
    "transition_id": {
      "$ref": "#/$defs/transitionId"
    },
    "cycle_id": {
      "$ref": "#/$defs/cycleId"
    },
    "previous_status": {
      "$ref": "#/$defs/cycleStatus"
    },
    "next_status": {
      "$ref": "#/$defs/cycleStatus"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transitioned_at": {
      "$ref": "#/$defs/dateTime"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "transition_hash": {
      "$ref": "#/$defs/contentHash"
    }
  },
  "$defs": {
    "transitionId": {
      "type": "string",
      "pattern": "^STID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^VCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "cycleStatus": {
      "type": "string",
      "enum": [
        "origin_registered",
        "derivative_created",
        "trace_recorded",
        "audit_pending",
        "audit_provisional",
        "audit_verified",
        "royalty_calculated",
        "settlement_pending",
        "settlement_processing",
        "settlement_failed",
        "settled",
        "disputed",
        "reconciliation_pending",
        "reconciliation_processing",
        "reconciled"
      ]
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      }
    }
  }
}
