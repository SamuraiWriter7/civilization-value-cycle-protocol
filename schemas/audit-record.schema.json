{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:audit_record:v0.4",
  "title": "CVCP Audit Record v0.4",
  "description": "Audits Evidence and Contribution Assessments and expresses attribution confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "audit_id",
    "derivative_id",
    "trace_chain_ref",
    "trace_refs",
    "evidence_assessment_refs",
    "contribution_assessment_ref",
    "auditor_id",
    "status",
    "audit_profile",
    "confidence",
    "confidence_components",
    "contributions",
    "evidence_refs",
    "reasoning_summary",
    "audited_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.4"
    },
    "record_type": {
      "const": "audit_record"
    },
    "audit_id": {
      "$ref": "#/$defs/auditId"
    },
    "derivative_id": {
      "$ref": "#/$defs/derivativeId"
    },
    "trace_chain_ref": {
      "$ref": "#/$defs/traceChainId"
    },
    "trace_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/traceId"
      }
    },
    "evidence_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceAssessmentId"
      }
    },
    "contribution_assessment_ref": {
      "$ref": "#/$defs/contributionAssessmentId"
    },
    "auditor_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "verified",
        "provisional",
        "disputed",
        "rejected"
      ]
    },
    "audit_profile": {
      "$ref": "#/$defs/auditProfile"
    },
    "confidence": {
      "$ref": "#/$defs/score"
    },
    "confidence_components": {
      "$ref": "#/$defs/confidenceComponents"
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auditContribution"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reasoning_summary": {
      "type": "string",
      "minLength": 1
    },
    "audited_at": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "provisional"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "contributions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "originId": {
      "type": "string",
      "pattern": "^OID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "derivativeId": {
      "type": "string",
      "pattern": "^DID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^TID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "traceChainId": {
      "type": "string",
      "pattern": "^TCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "evidenceAssessmentId": {
      "type": "string",
      "pattern": "^EAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "contributionAssessmentId": {
      "type": "string",
      "pattern": "^CAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "auditId": {
      "type": "string",
      "pattern": "^AID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "auditProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "verified_threshold",
        "provisional_threshold"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "verified_threshold": {
          "$ref": "#/$defs/score"
        },
        "provisional_threshold": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "confidenceComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_quality",
        "trace_completeness",
        "contribution_stability",
        "methodology_reliability",
        "conflict_penalty"
      ],
      "properties": {
        "evidence_quality": {
          "$ref": "#/$defs/score"
        },
        "trace_completeness": {
          "$ref": "#/$defs/score"
        },
        "contribution_stability": {
          "$ref": "#/$defs/score"
        },
        "methodology_reliability": {
          "$ref": "#/$defs/score"
        },
        "conflict_penalty": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "auditContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "weight",
        "evidence_trace_ids"
      ],
      "properties": {
        "origin_id": {
          "$ref": "#/$defs/originId"
        },
        "weight": {
          "$ref": "#/$defs/score"
        },
        "evidence_trace_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/traceId"
          }
        }
      }
    }
  }
}
