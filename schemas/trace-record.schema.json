{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:trace_record:v0.3",
  "title": "CVCP Trace Record v0.3",
  "description": "Records a neutral causal event for a Derivative, including explicit parent links and an integrity hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "trace_id",
    "derivative_id",
    "sequence",
    "event_type",
    "input_refs",
    "output_refs",
    "timestamp",
    "evidence",
    "event_hash"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.3"
    },
    "record_type": {
      "const": "trace_record"
    },
    "trace_id": {
      "$ref": "#/$defs/traceId"
    },
    "derivative_id": {
      "$ref": "#/$defs/derivativeId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "enum": [
        "reference",
        "transform",
        "reasoning",
        "decision",
        "action",
        "result"
      ]
    },
    "previous_trace_id": {
      "$ref": "#/$defs/traceId"
    },
    "causal_parent_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/traceId"
      },
      "default": []
    },
    "input_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timestamp": {
      "$ref": "#/$defs/dateTime"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "event_hash": {
      "$ref": "#/$defs/contentHash"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 0
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "not": {
          "required": [
            "previous_trace_id"
          ]
        },
        "properties": {
          "causal_parent_refs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sequence": {
            "minimum": 1
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "required": [
          "previous_trace_id"
        ]
      }
    }
  ],
  "$defs": {
    "traceId": {
      "type": "string",
      "pattern": "^TID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "derivativeId": {
      "type": "string",
      "pattern": "^DID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "enum": [
                  "sha256",
                  "blake3"
                ]
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha384"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{96}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "algorithm"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[A-Fa-f0-9]{128}$"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "value"
      ],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": [
            "record_ref",
            "uri",
            "hash",
            "statement",
            "external_receipt"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/contentHash"
        }
      }
    }
  }
}
