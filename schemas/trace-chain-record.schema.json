{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:trace_chain_record:v0.5",
  "title": "CVCP Trace Chain Record v0.5",
  "description": "Groups Trace Records into one causal DAG for one Derivative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "trace_chain_id",
    "derivative_id",
    "trace_refs",
    "root_trace_id",
    "terminal_trace_ids",
    "event_count",
    "chain_hash",
    "created_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.5"
    },
    "record_type": {
      "const": "trace_chain_record"
    },
    "trace_chain_id": {
      "$ref": "#/$defs/traceChainId"
    },
    "derivative_id": {
      "$ref": "#/$defs/derivativeId"
    },
    "trace_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/traceId"
      }
    },
    "root_trace_id": {
      "$ref": "#/$defs/traceId"
    },
    "terminal_trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/traceId"
      }
    },
    "event_count": {
      "type": "integer",
      "minimum": 1
    },
    "chain_hash": {
      "$ref": "#/$defs/contentHash"
    },
    "created_at": {
      "$ref": "#/$defs/dateTime"
    }
  },
  "$defs": {
    "traceChainId": {
      "type": "string",
      "pattern": "^TCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "derivativeId": {
      "type": "string",
      "pattern": "^DID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^TID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      }
    }
  }
}
