{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:contribution_assessment_record:v0.5",
  "title": "CVCP Contribution Assessment Record v0.5",
  "description": "Explains and normalizes Origin contribution weights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "contribution_assessment_id",
    "derivative_id",
    "trace_chain_ref",
    "evidence_assessment_refs",
    "methodology",
    "contributions",
    "normalization_status",
    "assessor_id",
    "assessed_at",
    "assessment_hash"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.5"
    },
    "record_type": {
      "const": "contribution_assessment_record"
    },
    "contribution_assessment_id": {
      "$ref": "#/$defs/contributionAssessmentId"
    },
    "derivative_id": {
      "$ref": "#/$defs/derivativeId"
    },
    "trace_chain_ref": {
      "$ref": "#/$defs/traceChainId"
    },
    "evidence_assessment_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceAssessmentId"
      }
    },
    "methodology": {
      "$ref": "#/$defs/methodology"
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contribution"
      }
    },
    "normalization_status": {
      "enum": [
        "normalized",
        "pending"
      ]
    },
    "assessor_id": {
      "type": "string",
      "minLength": 1
    },
    "assessed_at": {
      "$ref": "#/$defs/dateTime"
    },
    "assessment_hash": {
      "$ref": "#/$defs/contentHash"
    }
  },
  "$defs": {
    "originId": {
      "type": "string",
      "pattern": "^OID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "derivativeId": {
      "type": "string",
      "pattern": "^DID:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "traceChainId": {
      "type": "string",
      "pattern": "^TCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "evidenceAssessmentId": {
      "type": "string",
      "pattern": "^EAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "contributionAssessmentId": {
      "type": "string",
      "pattern": "^CAID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "version",
        "coefficients",
        "evidence_adjustment"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "coefficients": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference_depth",
            "transformation_dependency",
            "reasoning_influence",
            "decision_influence",
            "outcome_influence"
          ],
          "properties": {
            "reference_depth": {
              "$ref": "#/$defs/score"
            },
            "transformation_dependency": {
              "$ref": "#/$defs/score"
            },
            "reasoning_influence": {
              "$ref": "#/$defs/score"
            },
            "decision_influence": {
              "$ref": "#/$defs/score"
            },
            "outcome_influence": {
              "$ref": "#/$defs/score"
            }
          }
        },
        "evidence_adjustment": {
          "enum": [
            "none",
            "multiplicative"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_id",
        "evidence_assessment_ref",
        "reference_depth",
        "transformation_dependency",
        "reasoning_influence",
        "decision_influence",
        "outcome_influence",
        "evidence_strength",
        "raw_score",
        "adjusted_score",
        "normalized_weight"
      ],
      "properties": {
        "origin_id": {
          "$ref": "#/$defs/originId"
        },
        "evidence_assessment_ref": {
          "$ref": "#/$defs/evidenceAssessmentId"
        },
        "reference_depth": {
          "$ref": "#/$defs/score"
        },
        "transformation_dependency": {
          "$ref": "#/$defs/score"
        },
        "reasoning_influence": {
          "$ref": "#/$defs/score"
        },
        "decision_influence": {
          "$ref": "#/$defs/score"
        },
        "outcome_influence": {
          "$ref": "#/$defs/score"
        },
        "evidence_strength": {
          "$ref": "#/$defs/score"
        },
        "raw_score": {
          "$ref": "#/$defs/score"
        },
        "adjusted_score": {
          "$ref": "#/$defs/score"
        },
        "normalized_weight": {
          "$ref": "#/$defs/score"
        }
      }
    }
  }
}
