{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cvcp:schema:reconciliation_record:v0.5",
  "title": "CVCP Reconciliation Record v0.5",
  "description": "Records append-only correction, reconciliation, retry, reassessment, or recovery actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_type",
    "reconciliation_id",
    "cycle_id",
    "affected_record_refs",
    "resolution_type",
    "resolution_actions",
    "resulting_record_refs",
    "reconciled_by",
    "authorization_refs",
    "status",
    "reconciled_at",
    "reconciliation_hash"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.5"
    },
    "record_type": {
      "const": "reconciliation_record"
    },
    "reconciliation_id": {
      "$ref": "#/$defs/reconciliationId"
    },
    "cycle_id": {
      "$ref": "#/$defs/cycleId"
    },
    "dispute_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/disputeId"
      },
      "default": []
    },
    "cause_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "affected_record_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolution_type": {
      "enum": [
        "no_change",
        "allocation_correction",
        "beneficiary_correction",
        "royalty_recalculation",
        "settlement_retry",
        "settlement_reversal",
        "audit_reassessment",
        "cycle_reopen",
        "other"
      ]
    },
    "resolution_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resolutionAction"
      }
    },
    "resulting_record_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reconciled_by": {
      "type": "string",
      "minLength": 1
    },
    "authorization_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "reconciled_at": {
      "$ref": "#/$defs/dateTime"
    },
    "reconciliation_hash": {
      "$ref": "#/$defs/contentHash"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "dispute_refs"
          ],
          "properties": {
            "dispute_refs": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "cause_refs"
          ],
          "properties": {
            "cause_refs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "resolution_type": {
            "enum": [
              "allocation_correction",
              "beneficiary_correction",
              "royalty_recalculation",
              "settlement_retry",
              "settlement_reversal",
              "audit_reassessment",
              "cycle_reopen"
            ]
          }
        },
        "required": [
          "resolution_type"
        ]
      },
      "then": {
        "properties": {
          "authorization_refs": {
            "minItems": 1
          },
          "resulting_record_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resolution_type": {
            "const": "no_change"
          }
        },
        "required": [
          "resolution_type"
        ]
      },
      "then": {
        "properties": {
          "resulting_record_refs": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "reconciliationId": {
      "type": "string",
      "pattern": "^RCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "disputeId": {
      "type": "string",
      "pattern": "^DPID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "cycleId": {
      "type": "string",
      "pattern": "^VCID:[A-Za-z0-9._-]+/[0-9]{8}T[0-9]{6}Z/[A-Za-z0-9._-]+$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256",
            "sha384",
            "sha512",
            "blake3"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        }
      }
    },
    "resolutionAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "target_ref"
      ],
      "properties": {
        "action_type": {
          "enum": [
            "retain",
            "supersede",
            "recalculate",
            "retry",
            "reverse",
            "reissue",
            "reassess",
            "close"
          ]
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "result_ref": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_type": {
                "enum": [
                  "supersede",
                  "recalculate",
                  "retry",
                  "reverse",
                  "reissue",
                  "reassess"
                ]
              }
            },
            "required": [
              "action_type"
            ]
          },
          "then": {
            "required": [
              "result_ref"
            ]
          }
        }
      ]
    }
  }
}
